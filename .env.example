# Local development defaults: MemoryVenue, dev trading routes on, one
# browser origin allowed. Copy to `.env`.

PORT=4100
HOST=0.0.0.0
VENUE=memory
DEV_TRADING=1
NETWORK=devnet
ALLOWED_ORIGINS=http://localhost:3000

# Where candles and fund grants are snapshotted (JSON, on an interval and on
# shutdown, loaded at start).
DATA_DIR=./data
SNAPSHOT_INTERVAL_MS=30000

# VENUE=rollup: the service sends to the rollup only while somebody wants it
# to. It stays awake while a stream socket is open and this long after the
# last request (the health probe does not count), then sleeps until the next one.
IDLE_AFTER_MS=600000
# When the last stream socket closes (the page was closed), only this long is
# left, whatever requests came before. Long enough for a reload to reconnect.
IDLE_AFTER_LAST_SOCKET_MS=15000

# The fund button: one grant per address, plus a per-IP rate limit.
FUND_AMOUNT_NUSD=5000
FUND_IP_RATE_LIMIT=20
FUND_IP_RATE_WINDOW_MS=3600000

# Jupiter's price API v3 takes no key but allows roughly one request every
# two seconds, so every market's price is fetched in a single request on
# this interval.
JUPITER_BASE_URL=https://lite-api.jup.ag/price/v3
JUPITER_POLL_INTERVAL_MS=4000

# The venue-internal account that settles realised perpetual PnL, funding,
# and liquidation shortfalls. Seeded once at start.
INSURANCE_SEED_NUSD=10000000
MAX_FUNDING_RATE_BPS_PER_UPDATE=75
FUNDING_INTERVAL_MS=60000

# House market maker: quotes HOUSE_MAKER_LEVELS on each side, spread widening
# by HOUSE_MAKER_LEVEL_STEP_BPS per level, requoting on a price move past
# HOUSE_MAKER_REQUOTE_THRESHOLD_BPS or every HOUSE_MAKER_REQUOTE_INTERVAL_MS,
# skewed away from its own position and capped at a notional position limit.
HOUSE_MAKER_TICK_MS=1000
HOUSE_MAKER_LEVELS=5
HOUSE_MAKER_SPREAD_BPS=15
HOUSE_MAKER_LEVEL_STEP_BPS=5
HOUSE_MAKER_REQUOTE_THRESHOLD_BPS=12
HOUSE_MAKER_REQUOTE_INTERVAL_MS=90000
HOUSE_MAKER_POSITION_LIMIT_NUSD=50000
HOUSE_MAKER_MAX_SKEW_BPS=20

# Noise takers: a small pool of bot traders sending small random market
# orders so the tape keeps moving between requotes. NOISE_TAKERS_ENABLED=0
# opens, funds and starts none of them.
NOISE_TAKERS_ENABLED=1
NOISE_TAKER_TICK_MS=500
NOISE_TAKER_COUNT=6
# How many of those trade. Each one that trades keeps a client running on the rollup.
NOISE_TAKER_ACTIVE=2
NOISE_TAKER_MIN_INTERVAL_MS=3000
NOISE_TAKER_MAX_INTERVAL_MS=5000
NOISE_TAKER_WORST_SLIPPAGE_BPS=50
NOISE_TAKER_STARTING_NUSD=100000
NOISE_TAKER_STARTING_BASE=1000
NOISE_TAKER_SEED=42

# The liquidator: blind liquidation attempts on a few seats per tick.
# LIQUIDATOR_ENABLED=0 opens, funds and starts none. On a deployment that runs
# the order book repository's liquidation keeper it adds nothing: turn it off.
LIQUIDATOR_ENABLED=1
LIQUIDATOR_INTERVAL_MS=60000
LIQUIDATOR_STARTING_NUSD=1000000

STATS_LATENCY_WINDOW=500

# ---------------------------------------------------------------------------
# VENUE=rollup: the real order book program. Everything below is read only
# then, and the service refuses to start when a required value is missing.
# ---------------------------------------------------------------------------

# Required. Solana (checked once: the service stops if it is mainnet), the
# rollup's private endpoint through the query filter, and its websocket.
# SOLANA_RPC_URL=http://127.0.0.1:8899
# ROLLUP_RPC_URL=http://127.0.0.1:6699
# ROLLUP_WS_URL=ws://127.0.0.1:6700

# Optional. Deposits go to the `depositUrl` the deployment description names
# (the rollup's own port on the local stack, the private endpoint on a hosted
# one). Set this only to send them elsewhere, as a container does to reach
# the host's local stack.
# DEPOSIT_RPC_URL=http://host.docker.internal:7799

# Optional. The URLs GET /v1/deployment tells a browser to use. They default
# to the three above; set them when the service reaches the network at an
# address a browser cannot, as inside a container.
# PUBLIC_SOLANA_RPC_URL=http://localhost:8899
# PUBLIC_ROLLUP_RPC_URL=http://localhost:6699
# PUBLIC_ROLLUP_WS_URL=ws://localhost:6700

# Required, one of the two: the deployment description the order book
# repository's set-up writes, as a file path or as the JSON itself. Only the
# markets it has are followed. The marks and funding are the program's own:
# this service publishes no price and advances no funding.
# DEPLOYMENT_PATH=../orderbook-noirwire/.localnet/deployment.json
# DEPLOYMENT_JSON=

# Required secrets. Each key is the JSON array of 64 bytes in its keypair
# file, on one line, and must be the key the deployment names for that role.
# The faucet key only where the deployment names a faucet: without one, this
# service deposits nothing and hands out no test funds. Never commit them;
# nothing logs them.
# GATE_SECRET_KEY=
# FAUCET_SECRET_KEY=
# Or, for a run on your own machine, the path of each keypair file instead,
# so no key is copied anywhere:
# GATE_SECRET_KEY_FILE=../orderbook-noirwire/.localnet/localnet-gate.json
# FAUCET_SECRET_KEY_FILE=../orderbook-noirwire/.localnet/localnet-faucet.json

# Required secret: one 32-byte seed in hex per bot trader, separated by
# commas. One maker per market the deployment has, then NOISE_TAKER_COUNT
# takers and one liquidator when they are enabled: 10 with the defaults on a
# three-market test network, 1 for the maker alone on a one-market deployment.
# A seed's role is its place in that list among the bots that are on, so
# turning a flag on or off moves the seeds after it to other roles. A seed is
# that bot's owner key and so its seat on the exchange, which opens only so
# many new seats a day: generate the seeds once (openssl rand -hex 32) and
# keep the same ones on every restart.
# BOT_TRADER_SEEDS=

# Solana devnet, through MagicBlock's hosted endpoint: the order book's
# mainnet-profile deployment (Pyth prices, no faucet), the house maker alone,
# funded and listed by the operator (docs/deploy.md). The earlier devnet test
# network (devnet-deployment.json) is retired: the service refuses its
# description.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# ROLLUP_RPC_URL=https://devnet-tee.magicblock.app
# ROLLUP_WS_URL=wss://devnet-tee.magicblock.app
# DEPLOYMENT_PATH=../orderbook-noirwire/.keys/rehearsal-deployment.json
# GATE_SECRET_KEY_FILE=../orderbook-noirwire/.keys/rehearsal-gate.json
# NOISE_TAKERS_ENABLED=0
# LIQUIDATOR_ENABLED=0

# Where this service runs. It labels the latency figure in /v1/stats.
SERVICE_LOCATION=unnamed machine

# How long a bot's resting quote stays valid on the book by itself, so the
# quotes vanish if this service dies. Refreshed on every requote.
ROLLUP_QUOTE_EXPIRY_SECONDS=180

# Bot order sizes on the program, in nUSD of notional at the mark (the
# program refuses orders under 1 nUSD).
ROLLUP_MAKER_LEVEL_NUSD=400
ROLLUP_TAKER_MIN_NUSD=5
ROLLUP_TAKER_MAX_NUSD=50

# How many seat numbers the liquidator tries blind on each market per tick,
# and how many seats on the exchange were opened by something other than this
# service (a set-up's own test traders), so its sweep reaches past them.
LIQUIDATOR_SEATS_PER_TICK=2
LIQUIDATOR_EXTRA_SEATS=8
