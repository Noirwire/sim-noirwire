{
  "name": "sim-noirwire",
  "version": "0.1.0",
  "description": "A simulated order book that makes the NoirWire test network feel alive and measurable.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file .env dist/main.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/websocket": "11.3.3",
    "@noirwire/orderbook": "file:vendor/noirwire-orderbook-0.3.1.tgz",
    "@solana/web3.js": "1.99.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
